// 宠归星畔 · 联机串门版
// 注意：SQLite 不支持 Prisma enum，权限/动作枚举用 String 存储，
// 取值集中在 src/lib/constants.ts，服务端统一校验。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  nickname  String
  createdAt DateTime @default(now())

  planets             Planet[]
  memories            Memory[]
  // 我发起/收到的好友关系（去重由复合唯一索引保证）
  sentFriendships     Friendship[]    @relation("FriendshipRequester")
  receivedFriendships Friendship[]    @relation("FriendshipAddressee")
  sentMessages        DirectMessage[] @relation("MessageSender")
  receivedMessages    DirectMessage[] @relation("MessageRecipient")
}

model Planet {
  id             String   @id @default(cuid())
  ownerId        String
  name           String
  theme          String   @default("aurora")
  // { name, species, persona }
  petProfileJson String
  // PRIVATE | INVITE | PUBLIC
  visibility     String   @default("INVITE")
  inviteCode     String   @unique
  updatedAt      DateTime @updatedAt
  statsVisits    Int      @default(0)
  statsLights    Int      @default(0)
  statsStars     Int      @default(0)

  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  memories   Memory[]
  visits     Visit[]
  guestbooks Guestbook[]
  aiCaches   AiCache[]

  @@index([ownerId])
  @@index([visibility, updatedAt])
}

model Memory {
  id         String   @id @default(cuid())
  planetId   String
  ownerId    String
  imageUrl   String?
  text       String
  // PRIVATE | PUBLIC
  visibility String   @default("PRIVATE")
  createdAt  DateTime @default(now())

  planet Planet @relation(fields: [planetId], references: [id], onDelete: Cascade)
  owner  User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([planetId, visibility])
}

model Visit {
  id          String   @id @default(cuid())
  planetId    String
  visitorId   String
  visitorName String
  // ENTER | LIGHT | STAR | FEED | MESSAGE
  action      String
  createdAt   DateTime @default(now())

  planet Planet @relation(fields: [planetId], references: [id], onDelete: Cascade)

  @@index([planetId, createdAt])
}

model Guestbook {
  id          String   @id @default(cuid())
  planetId    String
  visitorId   String
  visitorName String
  content     String
  aiReply     String?
  // VISIBLE | DELETED
  status      String   @default("VISIBLE")
  createdAt   DateTime @default(now())

  planet Planet @relation(fields: [planetId], references: [id], onDelete: Cascade)

  @@index([planetId, status, createdAt])
}

model AiCache {
  id        String   @id @default(cuid())
  planetId  String
  visitorId String
  // welcome | brief | reply
  type      String
  content   String
  expiresAt DateTime

  planet Planet @relation(fields: [planetId], references: [id], onDelete: Cascade)

  @@index([planetId, visitorId, type])
}

// 好友关系：requester 发起申请，addressee 接收。
// 同一对用户只允许一条记录，方向由 requester < addressee 的字典序保证唯一。
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  // PENDING | ACCEPTED
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

// 好友之间的私信
model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  content     String
  // 收件人是否已读
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, read])
}
