# ---------- 数据库 ----------
DATABASE_URL="file:./dev.db"

# ---------- 智谱 GLM（仅服务端读取，前端永不暴露） ----------
# 三个场景（欢迎语 / 留言回复 / 访客简报）统一走 /api/ai/chat
# Key 留空时全部走模板降级，页面表现完全正常
ZAI_API_KEY=""
ZAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZAI_MODEL="glm-4-flash"
ZAI_IMAGE_MODEL="glm-image"

# 静态站（GitHub Pages）用的 AI 代理地址，由 proxy/ 目录单独部署到 Vercel
# 留空则静态站固定走模板降级
NEXT_PUBLIC_AI_PROXY_URL=""

# ---------- Supabase 登录（Project Settings → API） ----------
# 两个值都会进前端 bundle，属于公开信息；service_role key 绝对不要放这里
# 未配置时自动回退到「输入昵称进入」
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
