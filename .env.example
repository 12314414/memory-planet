# ---------- 数据库 ----------
DATABASE_URL="file:./dev.db"

# ---------- AI 代理（仅服务端读取，前端永不暴露） ----------
# 兼容 OpenAI 接口的服务商均可：DeepSeek / 混元 / 其它
# DeepSeek: https://api.deepseek.com/v1   model: deepseek-chat
# 混元:     https://api.hunyuan.cloud.tencent.com/v1   model: hunyuan-turbos-latest
AI_BASE_URL="https://api.deepseek.com/v1"
AI_MODEL="deepseek-chat"
AI_API_KEY=""
AI_TIMEOUT_MS="9000"

# ---------- Supabase 登录（Project Settings → API） ----------
# 两个值都会进前端 bundle，属于公开信息；service_role key 绝对不要放这里
# 未配置时自动回退到「输入昵称进入」
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
